{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@fixture/core": [
        "../core/src/index.ts"
      ],
      "@fixture/core/*": [
        "../core/src/*"
      ],
      "core": [
        "../core/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
