{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liorhalfon/archview/schema/model-3.json",
  "title": "archview model",
  "description": "The interchange format: a tree of nodes plus the imports between them. Views, cycles, layers, metrics and violations are all derived from this.",
  "type": "object",
  "required": [
    "schema",
    "language",
    "separator",
    "project",
    "nodes",
    "imports",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 4
    },
    "language": {
      "type": "string",
      "description": "the extractor that produced this"
    },
    "separator": {
      "enum": [".", "/"],
      "description": "splits a node id into its ancestors: '.' for Python, '/' for TypeScript"
    },
    "project": {
      "type": "string",
      "description": "the top-level package or TypeScript project analysed"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "parent",
          "kind",
          "file",
          "abstract"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "unique; its ancestors are the prefixes ending before a separator"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ],
            "description": "null for the project root and for externals"
          },
          "kind": {
            "enum": [
              "package",
              "module",
              "external"
            ],
            "description": "external: a third-party package, squashed into one node"
          },
          "file": {
            "type": [
              "string",
              "null"
            ],
            "description": "source file, relative to the project root"
          },
          "abstract": {
            "type": "boolean",
            "description": "defines an abstraction (Protocol, ABC, abstract methods)"
          }
        }
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "importer",
          "imported",
          "file",
          "line",
          "text",
          "type_checking",
          "lazy",
          "resolved"
        ],
        "additionalProperties": false,
        "properties": {
          "importer": {
            "type": "string"
          },
          "imported": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "description": "the source line, for display and for file:line jumps"
          },
          "resolved": {
            "type": ["string", "null"],
            "description": "the exact module or file reached, before an external target is squashed to its package name; null when the extractor cannot resolve it"
          },
          "type_checking": {
            "type": "boolean",
            "description": "only for type checkers: under if TYPE_CHECKING: (Python), import type (TypeScript)"
          },
          "lazy": {
            "type": "boolean",
            "description": "runs on call, not on import: inside a function (Python, require), import() (TypeScript)"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "module",
          "file",
          "line",
          "text",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "dynamic_import",
              "unresolved_import"
            ]
          },
          "module": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          },
          "target": {
            "type": [
              "string",
              "null"
            ],
            "description": "the imported name or specifier, when it is a string literal"
          }
        }
      }
    }
  }
}
